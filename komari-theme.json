{
  "name": "Komari 1999",
  "short": "komari-1999",
  "description": "Neo-Brutalism themed dashboard for Komari Monitor",
  "version": "1.0.0",
  "author": "ricebucket",
  "url": "https://github.com/r1cebucket/komari-theme-1999",
  "preview": "cover-image.png",
  "managedConfig": [
    {
      "name": "Accent Color",
      "key": "accentColor",
      "type": "select",
      "help": "Primary accent color for the theme",
      "options": ["yellow", "red", "blue", "green", "purple"],
      "default": "yellow"
    },
    {
      "name": "Card Style",
      "key": "cardStyle",
      "type": "select",
      "help": "Border style for cards",
      "options": ["thick", "thin", "double"],
      "default": "thick"
    },
    {
      "name": "Show Uptime",
      "key": "showUptime",
      "type": "switch",
      "help": "Display uptime on node cards",
      "default": true
    }
  ]
}
